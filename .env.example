# Secrets
DISCORD_BOT_TOKEN=
CELERIS_API_KEY=

# Conversation layer. Persona mode does not initialize Omnigent or MCP.
CONVERSATION_MODE=coordinator
PERSONA_SYSTEM_PROMPT=
PERSONA_MAX_RESPONSE_CHARACTERS=420
PERSONA_TEMPERATURE=0.4

# Required only when CONVERSATION_MODE=coordinator
OMNIGENT_REFRESH_TOKEN=
OMNIGENT_BASE_URL=
OMNIGENT_AGENT_NAME=codex-native-ui
OMNIGENT_HOST_ID=
OMNIGENT_WORKSPACE=

# Deployment-specific Discord configuration
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
ALLOWED_DISCORD_USER_ID=

# Speech model paths
VOICE_RUNTIME=staged
TTS_RUNTIME=pocket
SHERPA_ASR_MODEL_DIR=/opt/models/asr
SHERPA_TTS_MODEL_DIR=/opt/models/tts
SHERPA_ASR_THREADS=4
SHERPA_TTS_THREADS=4
SHERPA_TTS_SPEAKER_ID=0
SHERPA_TTS_SPEED=1
POCKET_TTS_PYTHON=/opt/pocket-tts/bin/python
POCKET_TTS_BRIDGE_PATH=/opt/omnigent-voice/pocket-tts/bridge.py
POCKET_TTS_VOICE=alba
POCKET_TTS_QUANTIZE=true

# Required only when VOICE_RUNTIME=kame. Model files are runtime mounts and are
# never built into the public image.
KAME_BRIDGE_PATH=/opt/omnigent-voice/bin/kame-bridge
KAME_CONFIG_PATH=/opt/models/kame/config.json
KAME_MODEL_PATH=/opt/models/kame/model-q4_k.gguf
KAME_MIMI_PATH=/opt/models/kame/mimi.gguf
KAME_TOKENIZER_PATH=/opt/models/kame/tokenizer.model
KAME_DEVICE=Vulkan0
KAME_CONTEXT_FRAMES=3000

# Optional tuning
DISCORD_SILENCE_MS=450
DISCORD_UTTERANCE_MERGE_MS=350
DISCORD_BARGE_IN_PEAK=0.08
SMART_TURN_COMPLETE_THRESHOLD=0.65
CELERIS_BASE_URL=https://inference.celeris.ai/celeris-1/v1
CELERIS_MODEL=celeris-1
CELERIS_HISTORY_COMPACT_MESSAGES=80
CELERIS_HISTORY_COMPACT_CHARACTERS=48000
CELERIS_HISTORY_KEEP_MESSAGES=24
CELERIS_HISTORY_COMPACTION_IDLE_MS=5000
LOG_LEVEL=info
LOG_FILE=
