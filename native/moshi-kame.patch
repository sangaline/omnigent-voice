+int moshi_lm_kame_oracle_text(
+    moshi_lm_gen_t * gen,
+    tokenizer_t * tok,
+    const char * text,
+    bool reset
+) {
+    if ( !gen->lm->model->kame )
+        return -1;
+    if ( reset ) {
+        gen->oracle_tokens.clear();
+        gen->oracle_tokens.push_back( gen->lm->model->text_initial_token_id );
+    }
+    if ( text && text[0] ) {
+        std::vector<int> tokens;
+        if ( !tok->sp.Encode( std::string(text), &tokens ).ok() )
+            return -2;
+        for ( int token : tokens )
+            gen->oracle_tokens.push_back( token );
+        return (int)tokens.size();
+    }
+    return 0;
+}
