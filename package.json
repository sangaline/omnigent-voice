{
  "name": "omnigent-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "eval": "tsx src/eval.ts",
    "eval:scenarios": "tsx src/scenario-eval.ts",
    "eval:persona": "tsx src/persona-scenario-eval.ts",
    "mcp": "node dist/mcp-server.js",
    "mcp:remote": "node dist/remote-mcp-server.js",
    "replay": "tsx src/replay.ts",
    "s2s:smoke": "node dist/s2s-smoke.js",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "discord.js": "14.27.0",
    "express": "5.1.0",
    "opusscript": "0.0.8",
    "pg": "^8.23.0",
    "sherpa-onnx-node": "1.13.6",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
