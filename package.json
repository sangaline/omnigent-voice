{
  "name": "omnigent-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "eval": "tsx src/eval.ts",
    "eval:scenarios": "tsx src/scenario-eval.ts",
    "eval:persona": "tsx src/persona-scenario-eval.ts",
    "mcp": "node dist/mcp-server.js",
    "mcp:remote": "node dist/remote-mcp-server.js",
    "replay": "tsx src/replay.ts",
    "s2s:smoke": "node dist/s2s-smoke.js",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "discord.js": "14.27.0",
    "express": "5.3.0",
    "opusscript": "0.1.1",
    "pg": "8.23.1",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
